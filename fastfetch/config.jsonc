{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "display": {
    "separator": " ┆ ",
    "color": {
        "keys": "38;2;202;114;192",
        "separator": "38;2;205;193;230"
    },
    "key": {
      "type": "string",
      "paddingLeft": 4
    }
  },
  "modules": [
    {
        "type": "title",
        // Poké Ball
        "format": "{#38;2;222;59;44}󰐝 {#38;2;202;114;192}{user-name}@{host-name}"
    },
    {
        "type": "custom",
        "format": "{#black}~-~-~-~-~-~-~-~-~-~"
    },
    {
        "type": "custom",
        "format": "  {#38;2;166;126;242}▶ {#38;2;164;197;244}SYSTEM"
    },
    {
        "type": "os",
        // Gear
        "key": "",
        "format": "{name} {version} {codename}"
    },
    {
        "type": "kernel",
        // Atom
        "key": "󰝨",
        "format": "{release}"
    },
    {
        "type": "custom",
        "format": "  {#38;2;166;126;242}▶ {#38;2;164;197;244}SOFTWARE"
    },
    {
        "type": "shell",
        // >_
        "key": ""
    },
    {
        "type": "de",
        // Monitor
        "key": ""
    },
//     {
//         "type": "theme",
//         // Monitor
//         "key": ""
//     },
//     {
//         "type": "icons",
//         // Image
//         "key": ""
//     },
//     {
//         "type": "font",
//         // Serif AA
//         "key": ""
//     },
//     {
//         "type": "terminalfont",
//         // Half-serif A
//         "key": ""
//     },
    {
        "type": "custom",
        "format": "  {#38;2;166;126;242}▶ {#38;2;164;197;244}HARDWARE"
    },
    {
        "type": "cpu",
        // Microprocessor
        "key": ""
    },
    {
        "type": "memory",
        // Chip (nf-fa-memory is a box drawing char?)
        "key": "󰍛"
    },
    {
        "type": "uptime",
        // Stopwatch
        "key": ""
    },
    {
        "type": "custom",
        "format": "  {#38;2;166;126;242}▶ {#38;2;164;197;244}MISC"
    },
    {
        "type": "disk",
        // Hard drive
        "key": "",
        "format": "{mountpoint} [{name}] {size-used} / {size-total} ({size-percentage})",
        "hideFS": "nfs:nfs4:cifs"
    },
    { // CadenceNet (Linux only)
        "type": "command",
        // Networked computer
        "key": "󰲝",
        "text": "if tailscale status > /dev/null; then hostname; else echo offline; fi"
    },
    { // Music (Linux only)
        "type": "command",
        // Audio file
        "key": "󰸪",
        "text": "playerctl metadata --format '{{artist}} -- {{title}} ({{duration(position)}} / {{duration(mpris:length)}})'"
    },
    {
        "type": "battery",
        // Battery
        "key": ""
    },
    {
        "type": "poweradapter",
        // Plug
        "key": ""
    },
    "break",
    {
      "type": "colors"
    }
  ]
}
